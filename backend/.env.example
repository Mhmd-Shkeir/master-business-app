# Copy this file to .env and fill in real values.

# Postgres connection string (Supabase). Get this from your Supabase project's
# Connect dialog -> Direct tab -> Connection Method -> "Session pooler".
# (Direct connections default to IPv6, which isn't reachable on every network;
# Session pooler is the free, IPv4-compatible substitute. Both env vars below
# use the same Session pooler URL — it works fine for migrations too.)
DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"
# Optional in the Vercel deployment; migrations use DATABASE_URL by default.
DIRECT_DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Generate a unique random secret of at least 32 characters for every environment.
# Example: openssl rand -hex 32
JWT_SECRET=""

PORT=4000

# Comma-separated exact frontend origins. Required explicitly in production.
# Example: CORS_ORIGINS="https://your-frontend.example.com"
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# OpenAI-compatible AI provider. Works with OpenAI itself, Groq, or any other
# OpenAI-compatible endpoint — just change the base URL and model id.
# Groq's model catalog changes over time; if this model 404s, check your
# available models at https://console.groq.com or `GET /openai/v1/models`
# and swap in a current chat model that supports tool/function calling.
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL_ID="openai/gpt-oss-120b"
AI_API_KEY="your-api-key-here"
